# Public identifiers only. Anything starting with EXPO_PUBLIC_ is bundled into the app and can be read
# by anyone who has it, so never put a secret here (the Google client secret stays on the backend).
EXPO_PUBLIC_API_URL=https://mo-fin-backend.vercel.app/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=889358560279-bfr08h3cltjdicufltrbnr3fuc4oa5un.apps.googleusercontent.com
# Added when iOS Google sign-in becomes testable:
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Release script only (npm run release:android). Same value as the backend's APP_RELEASE_TOKEN.
# Never prefix it with EXPO_PUBLIC_: that would put it inside the app.
APP_RELEASE_TOKEN=
