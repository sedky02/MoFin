    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "dev": "expo start --dev-client",
    "dev:tunnel": "expo start --dev-client --tunnel",
    "build:dev": "npx eas-cli build --profile development --platform android",
    "build:preview": "npx eas-cli build --profile preview --platform android",
    "build:prod": "npx eas-cli build --profile production --platform android",
    "build:prod:arm64": "npx eas-cli build --profile production-arm64 --platform android",
    "build:prod:legacy": "npx eas-cli build --profile production-legacy --platform android",
    "build:prod:split": "npx eas-cli build --profile production-arm64 --platform android --no-wait && npx eas-cli build --profile production-legacy --platform android --no-wait",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "doctor": "expo-doctor",
    "theme:sync": "node scripts/sync-theme.js",
    "theme:check": "node scripts/sync-theme.js --check",
    "core:drift": "node scripts/core-drift.mjs",
    "icons:sync": "node scripts/sync-icons.mjs",
    "icons:check": "node scripts/sync-icons.mjs --check"
  },
  "private": true
}
