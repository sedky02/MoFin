{
  "cli": {
    "version": ">= 27.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mo-fin-backend.vercel.app/api/v1",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "889358560279-bfr08h3cltjdicufltrbnr3fuc4oa5un.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mo-fin-backend.vercel.app/api/v1",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "889358560279-bfr08h3cltjdicufltrbnr3fuc4oa5un.apps.googleusercontent.com"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
