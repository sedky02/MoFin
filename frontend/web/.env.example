# Backend API base URL, called server-side only (route handlers / Server Components).
BACKEND_URL="http://localhost:3000/api/v1"
# Same value as the backend's BFF_SHARED_SECRET, so the backend trusts the client
# IP this app forwards for rate limiting. Server-side only: never NEXT_PUBLIC_.
# Required in production; optional locally.
# BFF_SHARED_SECRET="..."
