# Settings for the root docker-compose.yml (local demo).
#
#   cp .env.example .env && docker compose up --build
#
# FOR LOCAL DEMOS ONLY. These keys are public (they're in this repo), so never
# use them for anything reachable from the internet. For a real deployment,
# generate each key with e.g. `openssl rand -base64 48`.
# Every value here is also the default in docker-compose.yml, so `.env` is
# optional.

# --- Database (the postgres service; not published on the host) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mofin

# --- Signing keys: 32+ characters each, all different ---
JWT_ACCESS_SECRET=local-demo-only-jwt-access-key-7f3c9a1e5b2d4806
JWT_MCP_SECRET=local-demo-only-jwt-mcp-key-4b8e2d6a0c9f1e37
REFRESH_TOKEN_SECRET=local-demo-only-refresh-key-9d1f5c3a7e2b8064
# Shared by the web BFF and the API so rate limits see the real client IP.
BFF_SHARED_SECRET=local-demo-only-bff-shared-key-2a6c8e0f4b7d1935
# Encrypts the AI provider keys people store. 32 random bytes, base64: `openssl rand -base64 32`.
AI_KEY_ENCRYPTION_KEY=bG9jYWwtZGVtby1vbmx5LWFpLWtleS03ZjNjOWExZTU=

# --- Demo account ---
# Created on the first start (and again after `docker compose down -v`).
SEED_DEMO=true
ALLOW_DEMO_SEED=true
# Leave empty for the seed's default password.
DEMO_PASSWORD=

# --- Host ports ---
API_PORT=3000
WEB_PORT=3001

# --- Public URLs (as the browser sees them) ---
# If you change API_PORT or WEB_PORT, update these to match.
OAUTH_ISSUER=http://localhost:3000
WEB_URL=http://localhost:3001
# Build-time: shown on the Connect page. Rebuild the web image after changing.
NEXT_PUBLIC_MCP_URL=http://localhost:3000/api/v1/mcp

# Plain http://localhost needs non-Secure cookies; set to true behind HTTPS.
COOKIE_SECURE=false
