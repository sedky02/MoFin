generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Where a draft came from: the Drafts page's own input, the in-app chat (typed
/// or spoken), or an outside AI app connected over MCP.
enum DraftSource {
  COMPOSER
  CHAT
  VOICE
  MCP
}

enum AiChatRole {
  USER
  ASSISTANT
}

/// What a member other than the owner may do. The owner is Account.userId, not a
/// role row, so an account can't end up with no owner or with two.
enum AccountMemberRole {
  EDITOR
  VIEWER
}

/// An expired invitation stays PENDING: expiry is read from expiresAt.
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum AccountType {
  CASH
  BANK
  SAVINGS
  CRYPTO
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum RecurringInterval {
  MONTHLY
  YEARLY
}

// Declaration order is the sort order the Recurring view relies on: active
// series first, then paused, then cancelled.
enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum GoalType {
  BALANCE
  INCOME
  EXPENSE
}

enum GoalRecurrenceUnit {
  MONTH
  YEAR
}

enum GoalStatus {
  IN_PROGRESS
  ACHIEVED
  FAILED
}

model User {
  id                  String                   @id @default(uuid())
  email               String                   @unique
  /// When this person proved they control `email`: Google sign-in, a
  /// verification link, or a completed password reset. Null until then;
  /// registering alone proves nothing.
  emailVerifiedAt     DateTime?
  passwordHash        String?
  displayName         String?
  googleId            String?                  @unique
  settings            Json                     @default("{}")
  /// Push notification choices. Columns rather than `settings`, which clients replace wholesale.
  notifyMcpDrafts     Boolean                  @default(true)
  notifyRecurring     Boolean                  @default(true)
  /// Which stored AI key answers this person's questions; null means the shared one.
  aiProvider          String?
  /// When their own key fails, whether the shared key may answer that request instead.
  aiFallbackEnabled   Boolean                  @default(true)
  /// A temporary "Try the demo" user: password-less, seeded with sample data,
  /// deleted by DemoCleanupCron once expiresAt passes.
  isDemo              Boolean                  @default(false)
  /// Only set on demo users.
  expiresAt           DateTime?
  accounts            Account[]
  categories          Category[]
  transactions        Transaction[]
  transactionItems    TransactionItem[]
  drafts              DraftTransaction[]
  goals               Goal[]
  analyticsCaches     AnalyticsCache[]
  oauthCodes          AuthorizationCode[]
  refreshTokens       RefreshToken[]
  oauthRefreshTokens  OAuthRefreshToken[]
  oauthGrants         OAuthGrant[]
  authSessions        AuthSession[]
  passwordResets      PasswordResetToken[]
  aiChats             AiChat[]
  emailVerifications  EmailVerificationToken[]
  pushDevices         PushDevice[]
  aiCredentials       AiCredential[]
  accountMemberships  AccountMember[]
  sentInvitations     AccountInvitation[]
  createdTransactions Transaction[]            @relation("TransactionCreatedBy")
  updatedTransactions Transaction[]            @relation("TransactionUpdatedBy")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  // Demo cleanup selects isDemo && expiresAt < now; the active-demo cap counts
  // isDemo && expiresAt > now.
  @@index([isDemo, expiresAt])
}

model Account {
  id               String              @id @default(uuid())
  /// The owner, the only one per account. Other people reach it through `members`.
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  type             AccountType
  currency         String
  /// What the account held before tracking started, in its own currency.
  /// Added to the ledger-derived balance; never a transaction, so it stays
  /// out of income, expenses and Income/Expense goals.
  openingBalance   Decimal             @default(0) @db.Decimal(18, 4)
  metadata         Json                @default("{}")
  archivedAt       DateTime?
  transactionItems TransactionItem[]
  goals            Goal[]
  recurringFrom    Transaction[]       @relation("RecurringFromAccount")
  recurringTo      Transaction[]       @relation("RecurringToAccount")
  members          AccountMember[]
  invitations      AccountInvitation[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([userId, currency])
}

// Someone other than the owner who can reach an account. Goes with the account
// and with the user; their transactions on it stay (see Transaction.createdById).
model AccountMember {
  id         String            @id @default(uuid())
  accountId  String
  account    Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       AccountMemberRole
  /// This member's own AccountVisibility level. The owner's lives in Account.metadata.visibility.
  visibility String            @default("visible")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([accountId, userId])
  @@index([userId])
}

// An invitation to join an account. One row per (account, email): reinviting
// overwrites it, so the new token replaces the old one in the same write. Only
// the SHA-256 of the token is stored, so a database read never yields a usable link.
model AccountInvitation {
  id          String            @id @default(uuid())
  accountId   String
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User              @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  /// Trimmed and lowercased, like User.email.
  email       String
  role        AccountMemberRole
  tokenHash   String            @unique
  status      InvitationStatus  @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([accountId, email])
  @@index([email])
  @@index([invitedById])
  @@index([expiresAt])
}

model Category {
  id               String            @id @default(uuid())
  userId           String?
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  type             CategoryType
  color            String?
  icon             String?
  // A retired category: hidden from pickers but kept on the transactions,
  // reports and history that already use it. Restoring clears it.
  archivedAt       DateTime?
  transactions     Transaction[]
  transactionItems TransactionItem[]
  goals            Goal[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([userId, name, type])
}

model Transaction {
  id          String            @id @default(uuid())
  /// Whose ledger this is: the owner of the account(s) it posts to, which is
  /// not always who entered it (see createdById). Access goes through the
  /// accounts, not through this column.
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Who entered it. Null once that person has deleted their MoFin user: the
  /// record stays, because removing it would change the account's balance.
  createdById String?
  createdBy   User?             @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Who last edited it; null until someone does.
  updatedById String?
  updatedBy   User?             @relation("TransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  draftId     String?           @unique
  draft       DraftTransaction? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  type        TransactionType
  description String
  currency    String
  occurredAt  DateTime
  items       TransactionItem[]

  // Recurrence template fields — only populated on the root transaction that
  // started the series (parentTransactionId == null && isRecurring == true).
  // Kept separate from the root's own ledger-affecting fields (its existing
  // TransactionItem rows) so editing the series never mutates a past ledger entry.
  isRecurring            Boolean            @default(false)
  recurringInterval      RecurringInterval?
  recurringStatus        RecurringStatus?
  recurringEndDate       DateTime?
  nextOccurrenceAt       DateTime?
  recurringAmount        Decimal?           @db.Decimal(18, 4)
  recurringFromAccountId String?
  recurringFromAccount   Account?           @relation("RecurringFromAccount", fields: [recurringFromAccountId], references: [id], onDelete: Restrict)
  recurringToAccountId   String?
  recurringToAccount     Account?           @relation("RecurringToAccount", fields: [recurringToAccountId], references: [id], onDelete: Restrict)
  // Set when the cron paused the series because an occurrence couldn't be
  // posted (an archived account, a currency mismatch...): the reason, in words
  // for the user, and when it happened. A manual pause leaves the reason empty.
  // Resuming clears both.
  recurringError         String?
  lastFailedAt           DateTime?

  // Soft delete. Transactions are the user's own records, so they can be edited
  // (items are rewritten in place) and deleted. A deleted transaction keeps its
  // rows so it can be restored, but every balance, report, goal and list skips
  // it (`deletedAt: null`). A deleted recurring root generates nothing more.
  deletedAt DateTime?

  // Links a generated occurrence back to the root transaction of its series.
  parentTransactionId  String?
  parentTransaction    Transaction?  @relation("RecurringOccurrences", fields: [parentTransactionId], references: [id], onDelete: SetNull)
  recurringOccurrences Transaction[] @relation("RecurringOccurrences")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Guarantees a crash between generating an occurrence and advancing the
  // cursor cannot double-create the same occurrence on retry (SEC-XX).
  @@unique([parentTransactionId, occurredAt])
  @@index([userId, occurredAt])
  @@index([userId, deletedAt])
  @@index([userId, categoryId])
  @@index([isRecurring, recurringStatus, nextOccurrenceAt])
  @@index([parentTransactionId])
  @@index([recurringFromAccountId])
  @@index([recurringToAccountId])
  @@index([createdById])
  @@index([updatedById])
}

model TransactionItem {
  id            String          @id @default(uuid())
  /// The account owner, as on Transaction.
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  direction     LedgerDirection
  amount        Decimal         @db.Decimal(18, 4)
  currency      String
  memo          String?
  createdAt     DateTime        @default(now())

  @@index([userId, accountId, createdAt])
  // Reads of a shared account come in by account, whoever's ledger it is.
  @@index([accountId, transactionId])
  @@index([transactionId])
  @@index([categoryId])
}

model DraftTransaction {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction     Transaction?
  rawInput        String
  parsedData      Json
  confidenceScore Decimal      @db.Decimal(5, 4)
  status          DraftStatus  @default(PENDING)
  source          DraftSource  @default(COMPOSER)
  /// The connected app's name, for MCP drafts ("Claude").
  sourceClient    String?
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, status, createdAt])
}

model AnalyticsCache {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cacheKey   String
  payload    Json
  computedAt DateTime @default(now())
  expiresAt  DateTime

  @@unique([userId, cacheKey])
  @@index([expiresAt])
}

model Goal {
  id             String              @id @default(uuid())
  /// The owner of `account`. Access goes through the account.
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Only for INCOME/EXPENSE goals: counts just this category. Null counts every category.
  categoryId     String?
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name           String
  type           GoalType
  targetAmount   Decimal             @db.Decimal(18, 4)
  isRecurring    Boolean             @default(false)
  recurrenceUnit GoalRecurrenceUnit?
  periodStart    DateTime
  periodEnd      DateTime?
  archivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  instances      GoalInstance[]

  @@index([userId, archivedAt])
  @@index([accountId])
  @@index([categoryId])
}

model GoalInstance {
  id             String     @id @default(uuid())
  goalId         String
  goal           Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  targetAmount   Decimal    @db.Decimal(18, 4)
  progressAmount Decimal    @default(0) @db.Decimal(18, 4)
  status         GoalStatus @default(IN_PROGRESS)
  computedAt     DateTime   @default(now())

  @@unique([goalId, periodStart])
  @@index([status, periodEnd])
}

// --- OAuth 2.1 authorization server (MCP custom connector for claude.ai) ---

// A client registered via Dynamic Client Registration (RFC 7591).
// claude.ai is a public PKCE client, so there is no client secret.
model OAuthClient {
  id                      String              @id @default(uuid())
  clientId                String              @unique
  clientName              String?
  redirectUris            String[]
  grantTypes              String[]
  responseTypes           String[]
  scope                   String?
  tokenEndpointAuthMethod String              @default("none")
  createdAt               DateTime            @default(now())
  authorizationCodes      AuthorizationCode[]
  refreshTokens           OAuthRefreshToken[]
  grants                  OAuthGrant[]
}

// Single-use authorization code issued by /authorize and exchanged at /token.
// `code` stores a hash of the value handed back in the redirect, never the raw code.
model AuthorizationCode {
  id                  String      @id @default(uuid())
  code                String      @unique
  clientId            String
  client              OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  scope               String
  resource            String?
  usedAt              DateTime?
  expiresAt           DateTime
  createdAt           DateTime    @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Persisted, rotating refresh token. `tokenHash` is the hash of the opaque token.
// `familyId` groups rotations so that reuse of a rotated token revokes the whole family.
// First-party (web) refresh tokens, mirroring OAuthRefreshToken so a leaked
// token can be revoked instead of remaining valid statelessly until expiry.
model RefreshToken {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId    String
  rotatedToId String?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model OAuthRefreshToken {
  id          String      @id @default(uuid())
  tokenHash   String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  client      OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  scope       String
  resource    String?
  familyId    String
  rotatedToId String?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// Remembered user consent for a (user, client) pair so consent is shown only once.
model OAuthGrant {
  id       String      @id @default(uuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId String
  client   OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  scope    String

  @@unique([userId, clientId])
}

// First-party backend session created by the cross-origin login bridge.
// `sessionToken` stores a hash of the value placed in the mofin_as_session cookie.
model AuthSession {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Single-use password reset token sent by email. Only the SHA-256 of the
// random token is stored, so a database read never yields a usable link.
// `usedAt` is set when the token is redeemed, or when a newer request or a
// completed reset supersedes it; rows are kept rather than deleted for audit.
// A person's own API key for one AI provider. Only the AES-GCM ciphertext is stored (see
// SecretBox); nothing ever returns the key, only `last4`.
model AiCredential {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  ciphertext String
  last4      String
  /// A model other than the provider's default, checked against the provider's own list when saved.
  model      String?
  verifiedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, provider])
}

// One row per installed app that can receive pushes. The Expo token identifies the install, so
// signing in as someone else on the same phone moves the row to them.
model PushDevice {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expoToken  String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Single-use link proving control of an email address, same scheme as
// PasswordResetToken: only the SHA-256 is stored, `usedAt` is set when it is
// redeemed or a newer link supersedes it.
model EmailVerificationToken {
  id                 String    @id @default(uuid())
  tokenHash          String    @unique
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt          DateTime
  usedAt             DateTime?
  // SHA-256 of a random value kept in an httpOnly cookie of the browser that signed up: only that
  // browser gets a session when it redeems the link.
  browserBindingHash String?
  createdAt          DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A saved conversation with the in-app assistant. Read-only Q&A over the
// user's own data: nothing here is financial data, so a chat can be deleted.
// The model sees `summary` (a running digest of the older messages) plus the
// messages after the first `summarizedCount`, so long chats keep their context
// without re-sending everything.
model AiChat {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  summary         String?
  summarizedCount Int             @default(0)
  messages        AiChatMessage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, updatedAt])
}

// One turn of a chat. Only what the user typed and what the assistant
// answered are stored; the tool calls in between are not.
model AiChatMessage {
  id        String     @id @default(uuid())
  chatId    String
  chat      AiChat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      AiChatRole
  content   String
  /// Tools the assistant read to answer (assistant turns only).
  usedTools String[]   @default([])
  /// Charts computed on the server from the ledger (assistant turns only).
  charts    Json?
  /// Drafts this answer created (assistant turns only). Read back fresh, so a
  /// draft approved or rejected elsewhere shows its current status here.
  draftIds  String[]   @default([])
  createdAt DateTime   @default(now())

  @@index([chatId, createdAt])
}

// --- Mobile app releases (installable builds published outside the stores) ---

enum AppPlatform {
  ANDROID
  IOS
}

/// One published build. Rows are never edited: a new build is a new row, and a bad one is
/// withdrawn (hidden) rather than deleted, so the history stays.
model AppRelease {
  id          String      @id @default(uuid())
  platform    AppPlatform
  /// Shown to people, e.g. "1.0.3".
  version     String
  /// The build number (Android versionCode); what the update check compares.
  build       Int
  url         String
  /// An armeabi-v7a build for older phones, when one is published.
  legacyUrl   String?
  notes       String[]
  publishedAt DateTime    @default(now())
  withdrawnAt DateTime?
  createdAt   DateTime    @default(now())

  @@unique([platform, build])
  @@index([platform, withdrawnAt, build])
}
