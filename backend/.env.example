DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mofin?schema=public"
JWT_ACCESS_SECRET="replace-me-access"
# Separate key for MCP/OAuth access tokens — must differ from JWT_ACCESS_SECRET
# so an MCP token can never verify against the first-party web strategy.
JWT_MCP_SECRET="replace-me-mcp"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Derives rotated refresh tokens (lets a retry right after a rotation get the
# same new token). Any random 32+ character value.
REFRESH_TOKEN_SECRET="replace-me-refresh"
PORT=3000
# Shared with the web app (same value in frontend/web) so rate limits see the
# real client IP the BFF vouches for. Required in production; 32+ characters.
# BFF_SHARED_SECRET="..."

# --- OAuth 2.1 authorization server (MCP custom connector for claude.ai) ---
# Public base URL of THIS backend. In dev it is localhost; for claude.ai set it
# to the public HTTPS tunnel host. Must exactly match the token issuer/audience.
OAUTH_ISSUER="http://localhost:3000"
# Canonical MCP resource URL (token audience). Defaults to ${OAUTH_ISSUER}/api/v1/mcp.
# OAUTH_RESOURCE_URI="http://localhost:3000/api/v1/mcp"
# Where users log in (the Next.js web app) for the login bridge.
WEB_URL="http://localhost:3001"

# --- Google sign-in (optional; /auth/google returns 503 until all are set) ---
# GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."
# GOOGLE_TOKEN_URL="https://oauth2.googleapis.com/token"
# Native Google sign-in from the mobile app (POST /auth/google/id-token returns
# 503 until set): the client ids a Google ID token may be issued for, comma-
# separated. Put the web client id here (the Android app passes it as
# webClientId), and the iOS client id once there is one.
# GOOGLE_MOBILE_CLIENT_IDS="...apps.googleusercontent.com"

# --- Outgoing email (password reset links) ---
# Any SMTP relay works. With SMTP_HOST unset, emails are written to the log
# instead (outside production only; in production nothing is sent and only a
# warning is logged).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE="false"   # "true" for implicit TLS, usually port 465
# SMTP_USER="..."
# SMTP_PASS="..."
MAIL_FROM="MoFin <no-reply@mofin.local>"
# Development/test only, refused in production: write each email as a JSON
# file in this directory instead (the web e2e suite reads reset links here).
# MAIL_CAPTURE_DIR=".mail-outbox"
# How long a reset link stays valid.
PASSWORD_RESET_TTL="30m"

# --- Demo account (npx prisma db seed) ---
# Password for demo@mofin.app. Defaults to DemoPassw0rd! when unset. The seed
# refuses to run with NODE_ENV=production unless ALLOW_DEMO_SEED=true.
# DEMO_PASSWORD="DemoPassw0rd!"

# --- AI assistant (draft parsing + "Ask" chat on the Drafts page) ---
# Any OpenAI-compatible endpoint. Unset AI_API_KEY: drafts fall back to the
# local regex parser and the chat answers 503. Free key: https://console.groq.com
# AI_API_KEY="..."
# AI_BASE_URL="https://api.groq.com/openai/v1"
# AI_MODEL="openai/gpt-oss-120b"
# AI_TIMEOUT_MS=30000
# DEMO_AI_CHAT_CAP=15
